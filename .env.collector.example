# Credentials for the otel-collector container (infra/observability/compose.yml).
# Mounted via `env_file: ../../.env.collector` — kept separate from the repo
# root `.env` so CLICKHOUSE_* never leak into the rome container's environment.
#
# Copy this file to `.env.collector` and fill in the real values. The
# ClickStack/ClickHouse credentials are shared out of band — ask the team.
#
# Smoke-test once filled in:
#   curl --user "$CLICKHOUSE_USERNAME:$CLICKHOUSE_PASSWORD" \
#     --data-binary 'SELECT 1' "$CLICKHOUSE_ENDPOINT"
#
# After editing, `chmod 600 .env.collector` and re-run `pnpm dev:all`
# (recreate the otel-collector container so it picks up the new env_file).

CLICKHOUSE_ENDPOINT=https://<host>.clickhouse.cloud:8443
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
# Optional — collector config falls back to `default` if unset.
CLICKHOUSE_DATABASE=default
