{
  // The report sits outside every workspace tsconfig, so without this file
  // nothing typechecks it — rsbuild transpiles without checking types, and a
  // broken findings file would surface as a blank page instead of an error.
  //
  //   node .agents/skills/ux-semantics-audit/report/typecheck.mjs
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "typeRoots": ["../../../../packages/web/node_modules/@types"],
    "baseUrl": ".",
    // There is no node_modules beside this file and tsc resolves by walking up
    // from the importer, so every bare specifier is mapped into the workspace.
    "paths": {
      "@/*": ["../../../../packages/web/src/*"],
      "@rome-os/ui/*": ["../../../../packages/web/node_modules/@rome-os/ui/dist/*"],
      "react": ["../../../../packages/web/node_modules/@types/react"],
      "react/*": ["../../../../packages/web/node_modules/@types/react/*"],
      "react-dom": ["../../../../packages/web/node_modules/@types/react-dom"],
      "react-dom/*": ["../../../../packages/web/node_modules/@types/react-dom/*"],
      "*": ["../../../../packages/web/node_modules/*"]
    }
  },
  "include": ["*.ts", "*.tsx"]
}
