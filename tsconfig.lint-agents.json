{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The root package.json declares no "type", so NodeNext would read these as
    // CommonJS and reject `import.meta`. tsx runs them as the ES modules they are.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  },
  // Scoped to the AGENTS.md linter, not all of scripts/: nothing else there is
  // typechecked today, and widening this would gate the repo on files whose
  // module format and dependencies have never been checked.
  "include": ["scripts/check-agents-symlinks.ts", "scripts/check-agents-symlinks.test.ts"]
}
