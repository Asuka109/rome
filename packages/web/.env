# Rome Cloud origin used by rome-web at build time.
#
# Baked into the bundle as import.meta.env.ROME_CLOUD_ORIGIN — drives the
# "Browse App Store" external link and the per-instance install URL. The
# build fails when this is missing; override it locally via .env.local (which
# is gitignored) or in CI / staging / prod by exporting PANTHEON_HOST in the
# shell environment.
PANTHEON_HOST=https://romeos.cc
